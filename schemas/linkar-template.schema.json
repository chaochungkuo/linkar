{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://linkar.dev/schemas/linkar-template.schema.json",
  "title": "Linkar Template",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "run"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "required_any": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["str", "int", "float", "bool", "flag", "path", "list[path]"]
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "description": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "glob": {"type": "string", "minLength": 1}
        },
        "not": {"required": ["path", "glob"]}
      }
    },
    "cleanup": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "glob": {"type": "string", "minLength": 1},
          "type": {"type": "string", "enum": ["any", "dir", "file"]}
        },
        "oneOf": [
          {
            "required": ["path"],
            "not": {"required": ["glob"]}
          },
          {
            "required": ["glob"],
            "not": {"required": ["path"]}
          }
        ]
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {"type": "string", "minLength": 1}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": ["direct", "render"]
        },
        "verbose_by_default": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {"required": ["entry"], "not": {"required": ["command"]}},
        {"required": ["command"], "not": {"required": ["entry"]}}
      ]
    }
  }
}
