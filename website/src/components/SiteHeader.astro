---
import SiteNav from "./SiteNav.astro";
---

<header class="hero">
  <SiteNav />

  <div class="hero-grid">
    <div class="hero-copy">
      <div class="hero-badges">
        <span class="hero-badge">Git-backed packs</span>
        <span class="hero-badge">CLI + API + MCP runtime</span>
      </div>
      <p class="eyebrow">Reusable analysis templates for humans and machines</p>
      <h1 class="hero-title">Run shared analysis packs with traceable local state.</h1>
      <p class="lede">
        Package scripts, tools, and notebooks as templates with explicit inputs and outputs.
        Install packs from GitHub, update them deliberately, and record every run with params,
        outputs, and Git revision metadata.
      </p>
      <div class="install-block" data-install>
        <span class="install-label">Install</span>
        <code class="install-cmd" id="install-cmd">pipx install git+https://github.com/chaochungkuo/linkar.git</code>
        <button class="install-copy" type="button" aria-label="Copy install command" data-copy-btn>
          Copy
        </button>
      </div>
      <div class="hero-actions">
        <a class="button button-primary" href={`${import.meta.env.BASE_URL}tutorials/managing-git-backed-packs/`}>Manage packs</a>
        <a class="button button-secondary" href={`${import.meta.env.BASE_URL}tutorials/getting-started/`}>Get started</a>
      </div>
    </div>

    <div class="hero-panel">
      <div class="terminal-window">
        <div class="terminal-bar">
          <span></span><span></span><span></span>
        </div>
        <pre><code>$ linkar config pack add github:IZKF-Genomics/izkf_pack --id izkf_pack
$ linkar config pack update izkf_pack
$ linkar config pack list --format yaml

- id: izkf_pack
  ref: github:IZKF-Genomics/izkf_pack
  revision: 6463e5d47a68...
  active: true

$ linkar project init --name study
$ cd study
$ linkar run scrna_prep --binding default --verbose
$ linkar inspect run scrna_prep_001

.linkar/runs/scrna_prep_001/.linkar/meta.json
  pack.ref: github:IZKF-Genomics/izkf_pack
  pack.revision: 6463e5d47a68...
</code></pre>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const btn = document.querySelector("[data-copy-btn]");
    const cmd = document.getElementById("install-cmd");
    if (!btn || !cmd) return;
    btn.addEventListener("click", () => {
      navigator.clipboard.writeText(cmd.textContent.trim()).then(() => {
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = "Copy"; }, 2000);
      }).catch(() => {});
    });
  })();
</script>
