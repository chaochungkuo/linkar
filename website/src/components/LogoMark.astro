---
interface Props {
  className?: string;
}

const { className = "logo-mark" } = Astro.props;
---

<span class={className} aria-hidden="true">
  <svg viewBox="0 0 48 48" role="img">
    <path class="logo-link" d="M14 15.5h14.5l6 8.5" />
    <path class="logo-link" d="M14 32.5h13.5L34.5 24" />
    <circle class="logo-node logo-node-large" cx="14" cy="15.5" r="4.5" />
    <circle class="logo-node" cx="34.5" cy="24" r="5.25" />
    <circle class="logo-node logo-node-large" cx="14" cy="32.5" r="4.5" />
  </svg>
</span>
