---
import BaseLayout from "./BaseLayout.astro";
import DocsSidebar from "../components/DocsSidebar.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  sectionLabel: string;
  backHref: string;
  backLabel: string;
  headings?: Heading[];
}

const { title, description, sectionLabel, backHref, backLabel, headings = [] } = Astro.props;
const pathname = Astro.url.pathname;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const showToc = tocHeadings.length > 0;
---

<BaseLayout title={`${title} | Linkar Docs`} description={description}>
  <div class="docs-page-shell">
    <DocsSidebar currentPath={pathname} />
    <main class:list={["docs-shell", showToc && "docs-shell-with-toc"]}>
      <article class="docs-content prose">
        <a class="back-link" href={backHref}>{backLabel}</a>
        <p class="eyebrow">{sectionLabel}</p>
        <h1>{title}</h1>
        <p class="lede article-lede">{description}</p>
        <slot />
      </article>

      {showToc && (
        <aside class="docs-toc" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <nav class="toc-nav">
            {tocHeadings.map((heading) => (
              <a
                class:list={["toc-link", heading.depth === 3 && "toc-link-nested"]}
                href={`#${heading.slug}`}
              >
                {heading.text}
              </a>
            ))}
          </nav>
        </aside>
      )}
    </main>
  </div>
</BaseLayout>
