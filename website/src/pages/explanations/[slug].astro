---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

export async function getStaticPaths() {
  const explanations = await getCollection("explanations");
  return explanations.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const referenceSlugs = new Set([
  "cli-reference",
  "interfaces-and-automation",
  "local-api-reference",
  "discovery-layers-and-site-packs",
]);
const sectionLabel = referenceSlugs.has(entry.slug) ? "Reference" : "Concept";
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  sectionLabel={sectionLabel}
  backHref={`${import.meta.env.BASE_URL}docs/`}
  backLabel="Back to docs"
  headings={headings}
>
  <Content />
</DocsLayout>
