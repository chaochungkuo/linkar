---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const explanations = (await getCollection("explanations")).sort((a, b) => a.data.order - b.data.order);
const explanationHref = (slug: string) => `${import.meta.env.BASE_URL}explanations/${slug}/`;
const bySlug = new Map(explanations.map((entry) => [entry.slug, entry]));
const route = [
  "why-linkar",
  "pack-and-project-model",
  "template-runtime-contract",
  "params-bindings-and-resolution",
];
const groups = [
  {
    title: "Start Here",
    description: "Read these first to understand the problem Linkar is trying to solve and the boundary between reusable assets and local work.",
    slugs: ["why-linkar", "pack-and-project-model"],
  },
  {
    title: "Core Runtime Model",
    description: "Use these pages when you need to understand how templates run, how params resolve, and how project state is recorded.",
    slugs: [
      "template-runtime-contract",
      "params-bindings-and-resolution",
      "project-lifecycle",
      "project-runs-and-metadata",
    ],
  },
  {
    title: "Advanced And Integration",
    description: "These are for automation, reproducibility policy, site-specific discovery, and API-level integration.",
    slugs: [
      "interfaces-and-automation",
      "reproducibility-and-versioning",
      "discovery-layers-and-site-packs",
      "local-api-reference",
    ],
  },
];
---

<BaseLayout title="Concepts | Linkar" description="Understand the core ideas behind Linkar: reusable templates, reusable bindings, portable packs, readable projects, and human-plus-machine interfaces.">
  <div class="page-shell">
    <SiteNav />
    <main class="section-page">
      <section class="page-hero">
        <p class="eyebrow">Concepts</p>
        <h1 class="page-title">Conceptual reference.</h1>
        <p class="lede page-lede">
          These pages explain the runtime model behind Linkar. Use them when you need the why and
          the boundaries behind a command or template contract.
        </p>
      </section>

      <section class="section page-section-tight">
        <div class="section-heading">
          <p class="eyebrow">Recommended Route</p>
          <h2>Build the mental model in this order.</h2>
        </div>
        <div class="route-strip">
          {route.map((slug, index) => {
            const entry = bySlug.get(slug);
            if (!entry) return null;
            return (
              <a class="route-step" href={explanationHref(slug)}>
                <span class="route-number">{index + 1}</span>
                <span>{entry.data.title}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="section page-section-tight">
        <div class="docs-index-grid">
          {groups.map((group) => (
            <section class="docs-index-group">
              <div class="docs-index-group-head">
                <h2>{group.title}</h2>
                <p>{group.description}</p>
              </div>
              <ul class="docs-link-list">
                {group.slugs.map((slug) => {
                  const entry = bySlug.get(slug);
                  if (!entry) return null;
                  return (
                    <li>
                      <a href={explanationHref(slug)}>
                        <span>{entry.data.title}</span>
                        <small>{entry.data.description}</small>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
