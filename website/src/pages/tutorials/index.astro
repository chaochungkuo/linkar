---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const tutorials = (await getCollection("tutorials")).sort((a, b) => a.data.order - b.data.order);
const tutorialHref = (slug: string) => `${import.meta.env.BASE_URL}tutorials/${slug}/`;
const bySlug = new Map(tutorials.map((entry) => [entry.slug, entry]));
const route = [
  "getting-started",
  "packs-and-scope",
  "managing-git-backed-packs",
  "build-a-real-pack",
];
const groups = [
  {
    title: "Use A Shared Pack",
    description: "Start here when you want to install a pack, attach it to local work, and understand pack scope.",
    slugs: ["getting-started", "packs-and-scope", "managing-git-backed-packs"],
    tag: "User path",
  },
  {
    title: "Author Packs",
    description: "Use these guides when you are building templates, testing them locally, and preparing a pack for others.",
    slugs: [
      "build-a-real-pack",
      "authoring-script-sh",
      "python-entry-and-runtime-metadata",
      "testing-basic-templates",
    ],
    tag: "Authoring",
  },
  {
    title: "Advanced Workflows",
    description: "Continue here for external pipelines, agent/API use, and the bundled examples that teach specific patterns.",
    slugs: [
      "wrapping-external-pipelines",
      "using-linkar-from-agents",
      "example-pack-progression",
    ],
    tag: "Advanced",
  },
];
---

<BaseLayout title="Tutorials | Linkar" description="Step-by-step Linkar guides for starting projects, authoring templates, testing packs, and using Linkar from agents.">
  <div class="page-shell">
    <SiteNav />
    <main class="section-page">
      <section class="page-hero">
        <p class="eyebrow">Tutorials</p>
        <h1 class="page-title">Learn Linkar one path at a time.</h1>
        <p class="lede page-lede">
          Start with the shortest GitHub-pack path. Then continue based on the job you need Linkar
          to do.
        </p>
      </section>

      <section class="section page-section-tight">
        <div class="section-heading">
          <p class="eyebrow">Recommended Route</p>
          <h2>One clean first pass through the docs.</h2>
        </div>
        <div class="route-strip">
          {route.map((slug, index) => {
            const entry = bySlug.get(slug);
            if (!entry) return null;
            return (
              <a class="route-step" href={tutorialHref(slug)}>
                <span class="route-number">{index + 1}</span>
                <span>{entry.data.title}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="section page-section-tight">
        <div class="section-heading">
          <p class="eyebrow">Choose Your Path</p>
          <h2>Different roles need different first pages.</h2>
        </div>
        <div class="card-grid two-up">
          <a class="tutorial-card tutorial-link" href={tutorialHref("getting-started")}>
            <h3>Run a shared pack</h3>
            <p>Install a GitHub pack, create a project, run a template, and inspect the result.</p>
            <span class="status-tag">User path</span>
          </a>
          <a class="tutorial-card tutorial-link" href={tutorialHref("build-a-real-pack")}>
            <h3>Author and publish a pack</h3>
            <p>Build templates and bindings locally, then publish the pack so users can update it.</p>
            <span class="status-tag">Author path</span>
          </a>
          <a class="tutorial-card tutorial-link" href={tutorialHref("managing-git-backed-packs")}>
            <h3>Manage remote and local packs</h3>
            <p>Switch between GitHub and local checkouts, update caches, and pin revisions.</p>
            <span class="status-tag">Maintainer path</span>
          </a>
          <a class="tutorial-card tutorial-link" href={tutorialHref("using-linkar-from-agents")}>
            <h3>Automate through API or MCP</h3>
            <p>Use the same runtime from scripts, local services, and agent clients.</p>
            <span class="status-tag">Automation path</span>
          </a>
        </div>
      </section>

      {groups.map((group) => (
        <section class="section page-section-tight">
          <div class="section-heading">
            <p class="eyebrow">Tutorials</p>
            <h2>{group.title}</h2>
            <p class="section-copy">{group.description}</p>
          </div>
          <div class="card-grid two-up">
            {group.slugs.map((slug) => {
              const entry = bySlug.get(slug);
              if (!entry) return null;
              return (
                <a class="tutorial-card tutorial-link" href={tutorialHref(slug)}>
                  <h3>{entry.data.title}</h3>
                  <p>{entry.data.description}</p>
                  <span class="status-tag">{group.tag}</span>
                </a>
              );
            })}
          </div>
        </section>
      ))}
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
