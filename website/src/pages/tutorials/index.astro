---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";

const tutorials = (await getCollection("tutorials")).sort((a, b) => a.data.order - b.data.order);
const tutorialHref = (slug: string) => `${import.meta.env.BASE_URL}tutorials/${slug}/`;
const bySlug = new Map(tutorials.map((entry) => [entry.slug, entry]));
const route = [
  "getting-started",
  "packs-and-scope",
  "managing-git-backed-packs",
  "build-a-real-pack",
];
const groups = [
  {
    title: "Use A Shared Pack",
    description: "Start here when you want to install a pack, attach it to local work, and understand pack scope.",
    slugs: ["getting-started", "packs-and-scope", "managing-git-backed-packs"],
  },
  {
    title: "Author Packs",
    description: "Use these guides when you are building templates, testing them locally, and preparing a pack for others.",
    slugs: [
      "build-a-real-pack",
      "authoring-script-sh",
      "python-entry-and-runtime-metadata",
      "testing-basic-templates",
    ],
  },
  {
    title: "Advanced Workflows",
    description: "Continue here for external pipelines, agent/API use, and the bundled examples that teach specific patterns.",
    slugs: [
      "wrapping-external-pipelines",
      "using-linkar-from-agents",
      "example-pack-progression",
    ],
  },
];
---

<BaseLayout title="Tutorials | Linkar" description="Step-by-step Linkar guides for starting projects, authoring templates, testing packs, and using Linkar from agents.">
  <div class="page-shell">
    <SiteNav />
    <main class="section-page">
      <section class="page-hero">
        <p class="eyebrow">Tutorials</p>
        <h1 class="page-title">Task-oriented guides.</h1>
        <p class="lede page-lede">
          Follow a guide when you want a worked path. Use the docs index when you need reference
          material or the full runtime model.
        </p>
      </section>

      <section class="section page-section-tight">
        <div class="section-heading">
          <p class="eyebrow">Start Here</p>
          <h2>Recommended first pass.</h2>
        </div>
        <div class="route-strip">
          {route.map((slug, index) => {
            const entry = bySlug.get(slug);
            if (!entry) return null;
            return (
              <a class="route-step" href={tutorialHref(slug)}>
                <span class="route-number">{index + 1}</span>
                <span>{entry.data.title}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="section page-section-tight">
        <div class="docs-index-grid">
          {groups.map((group) => (
            <section class="docs-index-group">
              <div class="docs-index-group-head">
                <h2>{group.title}</h2>
                <p>{group.description}</p>
              </div>
              <ul class="docs-link-list">
                {group.slugs.map((slug) => {
                  const entry = bySlug.get(slug);
                  if (!entry) return null;
                  return (
                    <li>
                      <a href={tutorialHref(slug)}>
                        <span>{entry.data.title}</span>
                        <small>{entry.data.description}</small>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))}
        </div>
      </section>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
