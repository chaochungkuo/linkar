---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
type ShowItem = string | { label: string; code: true };

const examples = [
  {
    example: "basic",
    pattern: "Minimal template authoring",
    href: `${base}tutorials/testing-basic-templates/`,
    useWhen: "You want the smallest runnable pack before adding bindings or remote sources.",
    shows: [
      { label: "run.command", code: true },
      { label: "run.sh", code: true },
      { label: "run.py", code: true },
      "declared outputs",
      "glob outputs",
      "tools",
      "file inputs",
      "local tests",
    ] satisfies ShowItem[],
  },
  {
    example: "chaining",
    pattern: "Template output reuse",
    href: `${base}tutorials/example-pack-progression/#2-learn-pack-level-chaining-with-chaining`,
    useWhen: "One template is clear and you want to remove repeated manual path wiring.",
    shows: [
      "Pack-level default binding from one template's output into another template's input",
    ] satisfies ShowItem[],
  },
  {
    example: "binding_overrides",
    pattern: "Default versus caller binding",
    href: `${base}tutorials/example-pack-progression/#3-compare-defaults-and-caller-overrides-with-binding_overrides`,
    useWhen: "You need to compare project history, pack defaults, and explicit override bindings.",
    shows: ["How a caller can override a pack's default resolution behavior"] satisfies ShowItem[],
  },
  {
    example: "pack_management",
    pattern: "Ambiguous template ids",
    href: `${base}tutorials/example-pack-progression/#4-learn-pack-selection-with-pack_management`,
    useWhen: "Multiple packs expose the same template id.",
    shows: ["Active-pack selection", { label: "--pack", code: true }, "references"] satisfies ShowItem[],
  },
  {
    example: "remote",
    pattern: "GitHub-backed distribution",
    href: `${base}tutorials/example-pack-progression/#5-learn-remote-pack-references-with-remote`,
    useWhen: "Local packs are clear and you want revision-aware GitHub pack usage.",
    shows: [
      "Remote pack references",
      "cached assets",
      "provenance from resolved revisions",
    ] satisfies ShowItem[],
  },
];
---

<BaseLayout title="Examples | Linkar" description="Choose the right bundled Linkar example pack based on what you want to learn: basic template authoring, chaining, binding overrides, pack selection, or remote packs.">
  <div class="docs-page-shell">
    <DocsSidebar currentPath={pathname} />
    <main class="docs-shell">
      <article class="docs-content prose docs-index">
        <section class="docs-index-intro">
          <p class="eyebrow">Examples</p>
          <h1 class="page-title">Bundled packs you can read and run.</h1>
          <p class="lede page-lede">
            Use this cookbook when you know the pattern you want to inspect.
          </p>
        </section>

        <section class="docs-section">
          <div class="reference-table-wrap">
            <table class="reference-table">
              <thead>
                <tr>
                  <th>Example</th>
                  <th>Pattern</th>
                  <th>Use When</th>
                  <th>Shows</th>
                </tr>
              </thead>
              <tbody>
                {examples.map((item) => (
                  <tr>
                    <td><a href={item.href}>{item.example}</a></td>
                    <td>{item.pattern}</td>
                    <td>{item.useWhen}</td>
                    <td>
                      <span class="inline-code-list">
                        {item.shows.map((entry) =>
                          typeof entry === "string" ? <span>{entry}</span> : <code>{entry.label}</code>
                        )}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </article>
    </main>
  </div>
</BaseLayout>
